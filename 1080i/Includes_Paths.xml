        <value condition="$EXP[ShowTmdbActorMovies] + !String.IsEmpty(Window.Property(actormovies))">plugin://plugin.video.themoviedb.helper?info=stars_in_movies&amp;tmdb_type=person&amp;tmdb_id=$INFO[ListItem.Property(tmdb_id)]&amp;sort_key=release_date$VAR[Path_Params_Default]</value>
    </variable>

    <variable name="Path_PersonInfo_TVShows">
        <value condition="String.IsEmpty(Window(Home).Property(TMDbHelper.ListItem.DBType))">special://skin/extras/Null.xsp</value>
        <value condition="$EXP[ShowTmdbActorTvShows] + !String.IsEmpty(Window.Property(actortvshows))">plugin://plugin.video.themoviedb.helper?info=stars_in_tvshows&amp;tmdb_type=person&amp;tmdb_id=$INFO[ListItem.Property(tmdb_id)]&amp;sort_key=first_air_date$VAR[Path_Params_Default]</value>
    </variable>

    <variable name="Path_PersonInfo_CrewInBoth">
        <value condition="String.IsEmpty(Window(Home).Property(TMDbHelper.ListItem.DBType))">special://skin/extras/Null.xsp</value>
        <value condition="$EXP[ShowTmdbActorInCrew] + !String.IsEmpty(Window.Property(actorcrew))">plugin://plugin.video.themoviedb.helper?info=crew_in_both&amp;tmdb_type=person&amp;tmdb_id=$INFO[ListItem.Property(tmdb_id)]&amp;sort_key=year$VAR[Path_Params_Default]</value>
    </variable>

    <variable name="Path_MusicInfo_Youtube">
        <value condition="String.IsEqual(Window.Property(musicyoutube),1)">plugin://plugin.video.youtube/search/?q=$VAR[Path_Youtube_Query]</value>
    </variable>

    <variable name="Path_MusicInfo_MoreOfArtist">
        <value condition="!String.IsEmpty(ListItem.Artist)">musicdb://songs/?xsp=%7B%22order%22%3A%7B%22ignorefolders%22%3A0%2C%22method%22%3A%22songs%22%7D%2C%22rules%22%3A%7B%22and%22%3A%5B%7B%22field%22%3A%22artist%22%2C%22operator%22%3A%22contains%22%2C%22value%22%3A%5B%22$VAR[Path_Encoded_Artist]%22%5D%7D%5D%7D%2C%22type%22%3A%22songs%22%7D</value>
    </variable>

    <variable name="Path_MusicInfo_MostPlayedSong">
        <value>musicdb://songs/?xsp=%7B%22order%22%3A%7B%22direction%22%3A%22ascending%22%2C%22ignorefolders%22%3A0%2C%22method%22%3A%22songs%22%7D%2C%22rules%22%3A%7B%22and%22%3A%5B%7B%22field%22%3A%22artist%22%2C%22operator%22%3A%22contains%22%2C%22value%22%3A%5B%22$VAR[Path_Encoded_Artist]%22%5D%7D%5D%7D%2C%22type%22%3A%22songs%22%7D</value>
    </variable>
        
    <variable name="Path_MusicInfo_Encoder">
        <value>plugin://script.skinvariables/?info=get_encoded_string&amp;unencoded_paths=true&amp;&amp;$INFO[ListItem.Label]&amp;&amp;$INFO[ListItem.Title]&amp;&amp;$INFO[ListItem.Artist]&amp;&amp;$INFO[ListItem.AlbumArtist]&amp;&amp;$INFO[ListItem.Album]</value>        
    </variable>

    <variable name="Path_Encoded_Label">
        <value>$INFO[Container(4001).ListItemAbsolute(0).Label]</value>
    </variable>

	<variable name="Path_Encoded_Title">
		<value>$INFO[Container(4001).ListItemAbsolute(1).Label]</value>
	</variable>
	
    <variable name="Path_Encoded_TvShowTitle">
        <value>$INFO[Container(4001).ListItemAbsolute(2).Label]</value>
    </variable>
    
    <variable name="Path_Encoded_Artist">
        <value>$INFO[Container(4001).ListItemAbsolute(2).Label]</value>
    </variable>

    <variable name="Path_Encoded_AlbumArtist">
        <value>$INFO[Container(4001).ListItemAbsolute(3).Label]</value>
    </variable>

    <variable name="Path_Encoded_Album">
        <value>$INFO[Container(4001).ListItemAbsolute(4).Label]</value>
    </variable>

    <variable name="Path_Youtube_Query">
        <value condition="String.IsEqual(ListItem.DBType,movie) + !String.IsEmpty(ListItem.Title)">$VAR[Path_Encoded_Title]$INFO[ListItem.Year, ,] Movie</value>
        <value condition="String.IsEqual(ListItem.DBType,tvshow) + !String.IsEmpty(ListItem.Title)">$VAR[Path_Encoded_Title]$INFO[ListItem.Year, ,]</value>
        <value condition="String.IsEqual(ListItem.DBType,season) + !String.IsEmpty(ListItem.TvShowTitle)">$VAR[Path_Encoded_TvShowTitle]$INFO[ListItem.Season, Season ,]</value>
        <value condition="String.IsEqual(ListItem.DBType,episode) + !String.IsEmpty(ListItem.Title)">$VAR[Path_Encoded_TvShowTitle,, ]$VAR[Path_Encoded_Title]</value>
        <value condition="[String.IsEqual(ListItem.DBType,actor) | String.IsEqual(ListItem.Property(tmdb_type),person)] + !String.IsEmpty(ListItem.Label)">$VAR[Path_Encoded_Label]</value>
        <value condition="String.IsEqual(ListItem.DBType,artist) + !String.IsEmpty(ListItem.AlbumArtist)">$VAR[Path_Encoded_AlbumArtist] Music</value>
        <value condition="String.IsEqual(ListItem.DBType,artist) + !String.IsEmpty(ListItem.Artist)">$VAR[Path_Encoded_Artist] Music</value>
        <value condition="String.IsEqual(ListItem.DBType,album) + !String.IsEmpty(ListItem.Album)">$VAR[Path_Encoded_AlbumArtist,, ]$VAR[Path_Encoded_Album] Music</value>
        <value condition="String.IsEqual(ListItem.DBType,song) + !String.IsEmpty(ListItem.Title) + !String.IsEmpty(ListItem.AlbumArtist)">$VAR[Path_Encoded_AlbumArtist,, ]$VAR[Path_Encoded_Title] Music</value>
        <value condition="String.IsEqual(ListItem.DBType,song) + !String.IsEmpty(ListItem.Title)">$VAR[Path_Encoded_Artist,, ]$VAR[Path_Encoded_Title] Music</value>
        <value condition="!String.IsEmpty(ListItem.TvShowTitle)">$VAR[Path_Encoded_TvShowTitle]</value>
        <value condition="!String.IsEmpty(ListItem.AlbumArtist)">$VAR[Path_Encoded_AlbumArtist]</value>
        <value condition="!String.IsEmpty(ListItem.Artist)">$VAR[Path_Encoded_Artist]</value>
        <value condition="!String.IsEmpty(ListItem.Title)">$VAR[Path_Encoded_Title]</value>
        <value condition="!String.IsEmpty(ListItem.Label)">$VAR[Path_Encoded_Label]</value>
    </variable>

    <variable name="Path_Wikipedia_Title">
        <value condition="String.IsEqual(ListItem.DBType,album) + !String.IsEmpty(ListItem.Album)">$VAR[Path_Encoded_Album] $VAR[Path_Encoded_Artist]</value>
        <value condition="String.IsEqual(ListItem.DBType,song) + !String.IsEmpty(ListItem.Title)">$VAR[Path_Encoded_Title] $VAR[Path_Encoded_Artist]</value>
        <value condition="String.IsEqual(ListItem.DBType,artist) + !String.IsEmpty(ListItem.Artist)">$VAR[Path_Encoded_Artist]</value>
        <value condition="!String.IsEmpty(ListItem.TvShowTitle)">$VAR[Path_Encoded_TvShowTitle]</value>
        <value condition="!String.IsEmpty(ListItem.Title)">$VAR[Path_Encoded_Title]</value>
        <value>$VAR[Path_Encoded_Label]</value>
    </variable>

    <variable name="Path_Wikipedia_Language">
        <value condition="String.IsEqual(System.Language,Italian)">it</value>
        <value condition="String.IsEqual(System.Language,German)">de</value>
        <value condition="String.Contains(System.Language,French)">fr</value>
        <value condition="String.Contains(System.Language,Spanish)">es</value>
        <value>en</value>
    </variable>

    <variable name="Path_Set_Content">
        <value condition="ListItem.IsCollection + !String.IsEmpty(ListItem.DBID)">videodb://movies/sets/$INFO[ListItem.DBID]/?setid=$INFO[ListItem.DBID]</value>
        <value condition="Container(9500).ListItem.IsCollection + !String.IsEmpty(Container(9500).ListItem.DBID)">videodb://movies/sets/$INFO[Container(9500).ListItem.DBID]/?setid=$INFO[Container(9500).ListItem.DBID]</value>
        <value condition="Container(301).ListItem.IsCollection + !String.IsEmpty(Container(301).ListItem.DBID)">videodb://movies/sets/$INFO[Container(301).ListItem.DBID]/?setid=$INFO[Container(301).ListItem.DBID]</value>
     </variable>

    <variable name="Path_Album_Content">
        <value condition="ListItem.IsFolder + String.IsEqual(ListItem.DBType,album)">$INFO[ListItem.FolderPath]</value>
        <value condition="Container(9500).ListItem.IsFolder + String.IsEqual(Container(9500).ListItem.DBType,album)">$INFO[Container(9500).ListItem.FolderPath]</value>
        <value condition="Container(301).ListItem.IsFolder + String.IsEqual(Container(301).ListItem.DBType,album)">$INFO[Container(301).ListItem.FolderPath]</value>
    </variable>

    <variable name="Path_GlobalSearch_Query">
        <value condition="Window.IsVisible(MyVideoNav.xml)">movies=true&amp;tvshows=true&amp;episodes=true&amp;musicvideos=true&amp;actors=true&amp;directors=true"</value>
        <value condition="Window.IsVisible(MyMusicNav.xml)">artists=true&amp;albums=true&amp;songs=true&amp;musicvideos=true</value>
    </variable>
    
</includes>