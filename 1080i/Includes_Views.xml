	<variable name="View_ModeSwitch">
        <value condition="Container.Content(episodes) + Window.IsVisible(MyGames.xml)">games</value>
        <value condition="Container.Content(movies) + String.StartsWith(Container.FolderPath,videodb://movies/sets/)">movies-sets</value>
        <value condition="Container.Content(movies) + String.IsEmpty(Container.PluginName) + !String.StartsWith(Container.FolderPath,videodb://) + !String.StartsWith(Container.FolderPath,special://)">movies-files</value>
        <value condition="Container.Content(tvshows) + String.IsEmpty(Container.PluginName) + !String.StartsWith(Container.FolderPath,videodb://) + !String.StartsWith(Container.FolderPath,special://)">tvshows-files</value>
        <value condition="Container.Content(episodes) + String.IsEmpty(Container.PluginName) + !String.StartsWith(Container.FolderPath,videodb://) + !String.StartsWith(Container.FolderPath,special://)">episodes-files</value>
        <value condition="Container.Content(musicvideos) + String.IsEmpty(Container.PluginName) + !String.StartsWith(Container.FolderPath,videodb://) + !String.StartsWith(Container.FolderPath,special://)">musicvideos-files</value>
