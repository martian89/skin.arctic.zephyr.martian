{
    "infolabels": {
        "tmdb_id": "Window(Home).Property(TMDbHelper.Player.TMDb_ID)",
        "title": "Player.Title",
        "tvshow_tmdb_id": "Window(Home).Property(TMDbHelper.Player.TVShow.TMDb_ID)",
        "tvshow_title": "VideoPlayer.TvShowTitle",
        "season": "VideoPlayer.Season",
        "episode": "VideoPlayer.Episode",
        "year": "VideoPlayer.Year"
    },
    "values": {
        "tmdb_type": [
            {
                "rules": ["VideoPlayer.Content(movies)"],
                "value": "movie"
            },
            {
                "rules": ["VideoPlayer.Content(episodes)"],
                "value": "tv"
            }
        ],
        "tmdb_id_param": [
            {
                "rules": [
                    "{tmdb_type}==movie",
                    "{tmdb_id}!="
                ],
                "value": "&amp;tmdb_id={tmdb_id}"
            },
            {
                "rules": [
                    "{tmdb_type}==tv",
                    "{tvshow_tmdb_id}!="
                ],
                "value": "&amp;tmdb_id={tvshow_tmdb_id}"
            },
            ""
        ],
        "season_param": [
            {
                "rules": ["{season}!="],
                "value": "&amp;season={season}"
            },
            ""
        ],
        "episode_param": [
            {
                "rules": ["{episode}!="],
                "value": "&amp;episode={episode}"
            },
            ""
        ],
        "year_param": [
            {
                "rules": [
                    "{tmdb_type}==movie",
                    "{year}!="
                ],
                "value": "&amp;year={year}"
            },
            {
                "rules": [
                    "{tmdb_type}==tv",
                    "{year}!="
                ],
                "value": "&amp;episode_year={year}"
            },
            ""
        ],
        "query": [
            {
                "rules": ["{tmdb_type}==movie"],
                "value": "{title}"
            },
            {
                "rules": ["{tmdb_type}==tv"],
                "value": "{tvshow_title}"
            }
        ]
    },
    "encode": {
        "encoded_query": "{query}"
    },    
    "actions": [
        {
            "rules": ["{encoded_query}!="],
            "value": [
                "RunScript(plugin.video.themoviedb.helper,add_path=plugin://plugin.video.themoviedb.helper/?info=details&amp;tmdb_type={tmdb_type}{tmdb_id_param}&amp;query={encoded_query}{episode_param}{season_param}{year_param},call_auto=1190,return)"
            ]
        },
        "RunScript(plugin.video.themoviedb.helper,add_path=plugin://plugin.video.themoviedb.helper/?info=details&amp;tmdb_type={tmdb_type}{tmdb_id_param}{episode_param}{season_param}{year_param},call_auto=1190,return)"
    ]
}