        <value condition="$EXP[ShowTmdbCast] + String.IsEqual(ListItem.DBTYPE,tvshow)">plugin://plugin.video.themoviedb.helper/?info=cast&amp;tmdb_type=$VAR[Path_ContextParams_TMDbType]$VAR[Path_Param_Query]&amp;aggregate=true&amp;limit=250&amp;nextpage=false&amp;cacheonly=true</value>
        <value condition="$EXP[ShowTmdbCast]">plugin://plugin.video.themoviedb.helper/?info=cast&amp;tmdb_type=$VAR[Path_ContextParams_TMDbType]$VAR[Path_Param_Query]&amp;limit=250&amp;nextpage=false&amp;cacheonly=true</value>
    </variable>

    <variable name="Path_VideoInfo_OnlineCrew">
