<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog">
	<defaultcontrol always="true">100</defaultcontrol>
	<!--
	CONTROL IDs:
	  100 - Artwork list control (displays available options, click to select)
	  201 - Skip button
	  202 - Cancel button
	  203 - Multi-Art button (visibility controlled by show_multiart property)
	  204 - Change Language button (visibility controlled by show_change_language property)
	  205 - Sort button (toggles between popularity and resolution sort modes)
	  206 - Source button (toggles between all/TMDB/Fanart.tv filtering)

	WINDOW PROPERTIES use $INFO[Window.Property(name)]:
	  - heading: Title (e.g., "The Matrix")
	  - year: Release year
	  - mediatype: Media type (movie, tvshow, etc.)
	  - arttype: Specific art type (e.g., "poster", "fanart", "spine", "3dcase")
	  - artlayout: Layout category for shared layouts: "poster", "fanart", "landscape", "square"
	                Empty for unique types - use arttype instead (banner, clearlogo, characterart, spine, etc.)
	  - state: State text ("Missing artwork" / "Replace existing artwork" / "" for single)
	  - hascurrentart: "true" or "false" - whether item already has this art type
	  - currentarturl: URL of current artwork (if any)
	  - count: Smart display string ("58 available" or "24 of 58 available (English)")
	  - count_filtered: Raw number of filtered items (string)
	  - count_total: Raw number of total items (string)
	  - language: Display name for current language filter (e.g., "English")
	  - language_short: Current language filter code (e.g., "en")
	  - show_change_language: "true" or "false" - whether to show Change Language button
	  - show_multiart: "true" or "false" - multi-art button availability

	LISTITEM PROPERTIES use $INFO[ListItem.Property(name)]:
	  - is_current: "true" if this artwork is currently assigned
	  - dimensions: Width x Height (e.g., "1920x1080")
	  - width: Image width in pixels
	  - height: Image height in pixels
	  - source: Source name (e.g., "TMDB", "fanart.tv")
	  - language: Display name for this artwork's language (e.g., "English")
	  - language_short: Language code for this artwork (e.g., "en")
	  - season: Season number (when available)
	  - fullurl: Full resolution image URL
	  - index: 0-based index for selection tracking
	-->
	<controls>
        <include content="DefDialog">
            <param name="header_label" value="$INFO[Window.Property(heading)]$INFO[Window.Property(year), (,)]$INFO[Window.Property(arttype), - [CAPITALIZE],[/CAPITALIZE]]"/>
            <param name="width" value="1853"/>
            <param name="height" value="890"/>
                	
			<!-- Artwork Panel -->
			<control type="panel" id="100">
				<left>35</left>
				<top>110</top>
				<width>1420</width>
                <height>690</height>
				<onleft>201</onleft>
                <onright>63</onright>
                <pagecontrol>63</pagecontrol>
				<scrolltime>200</scrolltime>
				<orientation>vertical</orientation>
				<preloaditems>2</preloaditems>
				<!-- Poster layout: 6x2 grid (12 items) - 2:3 aspect ratio -->
                <include content="Def_Artwork_List_Layout">
                    <param name="width" value="236" />
                    <param name="height" value="345" />
                    <param name="image_height" value="345" />
                    <param name="title_overlay" value="true" />
                    <param name="diffuse" value="diffuse/widgetposter_new.png" />
                    <param name="condition" value="String.IsEqual(Window.Property(artlayout),poster)"/>             
                </include>
				<!-- Fanart / Landscape layout: 3x2 grid (6 items) - 16:9 aspect ratio -->
                <include content="Def_Artwork_List_Layout">
                    <param name="width" value="473" />
                    <param name="height" value="345" />
                    <param name="image_height" value="275" />
                    <param name="aspectratio" value="keep" />
                    <param name="condition" value="String.IsEqual(Window.Property(artlayout),fanart) | String.IsEqual(Window.Property(artlayout),landscape)"/>             
                </include>
				<!-- Banner: 2x3 grid (6 items) - 5.405:1 aspect ratio (unique arttype) -->
                <include content="Def_Artwork_List_Layout">
                    <param name="width" value="710" />
                    <param name="height" value="230" />
                    <param name="image_height" value="148" />
                    <param name="diffuse" value="diffuse/widgetbanner_small.png" />
                    <param name="condition" value="String.IsEqual(Window.Property(arttype),banner)"/>             
                </include>
				<!-- Square layout: 5x2 grid (10 items) - 1:1 aspect ratio -->
				<include content="Def_Artwork_List_Layout">
			        <param name="width" value="284" />
			        <param name="height" value="345" />
			        <param name="image_width" value="274" />
			        <param name="image_height" value="274" />
			        <param name="image_offset" value="5" />
                    <param name="diffuse" value="diffuse/widgetsquare_new.png" />
			        <param name="condition" value="String.IsEqual(Window.Property(artlayout),square) + !String.IsEqual(Window.Property(arttype),discart)"/>				
				</include>
                <!-- Discart: 5x2 grid (10 items) - 1:1 aspect ratio with border -->
                <include content="Def_Artwork_List_Layout">
                    <param name="width" value="284" />
                    <param name="height" value="345" />
                    <param name="image_width" value="274" />
                    <param name="image_height" value="274" />
                    <param name="image_offset" value="5" />
                    <param name="bordersize" value="8" />
                    <param name="diffuse" value="diffuse/widgetsquare_new.png" />
                    <param name="condition" value="String.IsEqual(Window.Property(arttype),discart)"/>             
                </include>
				<!-- Characterart: 6x2 grid (12 items) - 0.715 aspect ratio (unique arttype) -->
                <include content="Def_Artwork_List_Layout">
                    <param name="width" value="236" />
                    <param name="height" value="345" />
                    <param name="image_width" value="203" />
                    <param name="image_height" value="276" />
                    <param name="image_offset" value="17" />
                    <param name="aspectratio" value="keep" />
                    <param name="condition" value="String.IsEqual(Window.Property(arttype),characterart)"/>             
                </include>
				<!-- Clearlogo: 4x3 grid (12 items) - 2.581 aspect ratio (unique arttype) -->
                <include content="Def_Artwork_List_Layout">
                    <param name="width" value="355" />
                    <param name="height" value="230" />
                    <param name="image_width" value="314" />
                    <param name="image_height" value="160" />
                    <param name="image_offset" value="20" />
                    <param name="bordersize" value="8" />
                    <param name="aspectratio" value="keep" />
                    <param name="condition" value="String.IsEqual(Window.Property(arttype),clearlogo)"/>             
                </include>
				<!-- Spine: 8x2 grid (16 items) - 1:20 narrow portrait (unique arttype) -->
                <include content="Def_Artwork_List_Layout">
                    <param name="width" value="178" />
                    <param name="height" value="345" />
                    <param name="image_height" value="285" />
                    <param name="aspectratio" value="keep" />
                    <param name="condition" value="String.IsEqual(Window.Property(arttype),spine)"/>             
                </include>
				<!-- 3D Case: 4x2 grid (8 items) - 1.39:1 aspect ratio (unique arttype) -->
                <include content="Def_Artwork_List_Layout">
                    <param name="width" value="355" />
                    <param name="height" value="345" />
                    <param name="image_height" value="261" />
                    <param name="bordersize" value="8" />
                    <param name="aspectratio" value="keep" />
                    <param name="condition" value="String.IsEqual(Window.Property(arttype),3dcase)"/>             
                </include>
				<!-- 3D Flat: 3x2 grid (6 items) - 2.17:1 wide aspect ratio (unique arttype) -->
                <include content="Def_Artwork_List_Layout">
                    <param name="width" value="473" />
                    <param name="height" value="345" />
                    <param name="image_height" value="229" />
                    <param name="bordersize" value="8" />
                    <param name="aspectratio" value="keep" />
                    <param name="condition" value="String.IsEqual(Window.Property(arttype),3dflat)"/>             
                </include>
				<!-- 3D Face: 4x2 grid (8 items) - 1.47:1 aspect ratio (unique arttype) -->
                <include content="Def_Artwork_List_Layout">
                    <param name="width" value="355" />
                    <param name="height" value="345" />
                    <param name="image_height" value="248" />
                    <param name="bordersize" value="8" />
                    <param name="aspectratio" value="keep" />
                    <param name="condition" value="String.IsEqual(Window.Property(arttype),3dface)"/>             
                </include>
			</control>

            <!-- Lines -->
            <control type="image">
                <top>115</top>
                <right>375</right>
                <height>680</height>
                <width>1</width>
                <texture colordiffuse="Black12">common/white.png</texture>
                <animation effect="fade" start="0" end="100" time="100" condition="!Control.HasFocus(63) + !Container.Scrolling">Conditional</animation>
            </control>

            <!-- Scrollbar -->
            <include content="Furniture_Scrollbar_Dialog">
                <param name="id" value="63"/>
                <param name="height" value="678" />
                <param name="onleft" value="100"/>
                <param name="onright" value="201"/>
            </include>
			
            <!-- Button Group -->
            <control type="grouplist" id="9000">
                <top>115</top>              
                <right>42</right>
                <width>300</width>
                <itemgap>DialogButtonsItemgap</itemgap>
                <orientation>vertical</orientation>
                <onleft>63</onleft>
                <onright>100</onright>
                <control type="button" id="204">
                    <include>DefDialogButtons</include>
                    <label>$ADDON[script.skin.info.service 32120]</label>
                    <visible>String.IsEqual(Window.Property(show_change_language),true)</visible>
                </control>
                <!-- Sort Button -->
                <control type="button" id="205">
                    <include>DefDialogButtons</include>
                    <label>$INFO[Window.Property(sort_label)]</label>
                    <visible>String.IsEqual(Window.Property(show_sort_button),true)</visible>
                </control>
                <!-- Source Preference Button -->
                <control type="button" id="206">
                    <include>DefDialogButtons</include>
                    <label>$INFO[Window.Property(source_label)]</label>
                    <visible>String.IsEqual(Window.Property(show_source_button),true)</visible>
                </control>
                <!-- Multi-Art Button (visiblity controlled by script) -->
                <control type="button" id="203">
                    <include>DefDialogButtons</include>
                    <label>$ADDON[script.skin.info.service 32130]</label>
                    <visible>String.IsEqual(Window.Property(show_multiart),true)</visible>
                </control>
                <!-- Skip Button -->
                <control type="button" id="201">
                    <include>DefDialogButtons</include>
                    <label>$ADDON[script.skin.info.service 32128]</label>
                </control>
                <!-- Cancel Button -->
                <control type="button" id="202">
                    <include>DefDialogButtons</include>
                    <label>$LOCALIZE[222]</label>
                </control>
            </control>			

            <control type="label">
	            <include>Animation.FadeIn</include>
	            <include>Animation.FadeOut</include>
	            <left>40</left>
	            <font>Tiny</font>
	            <height>50</height>
	            <bottom>30</bottom>
	            <align>left</align>
	            <textcolor>Black70</textcolor>
                <label>$INFO[Container(100).CurrentItem] / $INFO[Window.Property(count)]</label>
            </control>    
		</include>
	</controls>
</window>
