<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog">
	<defaultcontrol>5001</defaultcontrol>
    <include>Animation.FadeIn</include>
    <include>Animation.FadeOut</include>
	<controls>
		<!-- Background -->
		<control type="image">
            <include>Dimensions_Fullscreen</include>
            <texture>common/black.png</texture>
		</control>
		<!-- Hidden list -->
		<control type="list" id="1520">
			<top>-3000</top>
			<left>-3000</left>
			<width>1</width>
			<height>1</height>
			<orientation>horizontal</orientation>
			<scrolltime>0</scrolltime>
			<itemlayout />
			<focusedlayout />
			<content>$INFO[Window.Property(container.viewer.path)]</content>
		</control>
		<!-- Hidden button -->
		<control type="button" id="5001">
			<left>-3000</left>
			<top>-3000</top>
			<width>1</width>
			<height>1</height>
			<texturenofocus />
			<texturefocus />
			<label />
			<onleft>Control.Move(1520,-1)</onleft>
			<onright>Control.Move(1520,1)</onright>
			<onup>noop</onup>
			<ondown>noop</ondown>
		</control>
		<control type="image">
			<width>100%</width>
			<height>100%</height>
			<texture background="true">$INFO[Container(1520).ListItem.Art(thumb)]</texture>
			<aspectratio>keep</aspectratio>
			<visible>!String.IsEmpty(Window.Property(viewer_ready))</visible>
		</control>
		<control type="group">
			<visible>!String.IsEmpty(Window.Property(viewer_ready))</visible>
			<visible>!System.IdleTime(3)</visible>
			<animation type="hidden" reversible="false">
                <effect type="slide" start="0,0" end="0,100" time="250" />
			</animation>
            <animation type="visible" reversible="false">
                <effect type="slide" start="0,100" end="0,0" time="150" />
            </animation>
			<control type="image">
				<bottom>0</bottom>
				<width>100%</width>
				<height>100</height>
                <texture colordiffuse="Background">common/white.png</texture>
                <animation effect="fade" start="100" end="95" time="0" condition="true">Conditional</animation>
			</control>
			<control type="image" description="Shadow">
			    <width>100%</width>
			    <height>1</height>
			    <bottom>100</bottom>
			    <texture colordiffuse="BoxHomerow">common/sch2.png</texture>
                <visible>Skin.HasSetting(global.showborders)</visible>
			</control>
			<!-- Image count, or the provider for one picker image -->
			<control type="label">
				<left>SidePad</left>
				<bottom>0</bottom>
				<width>300</width>
				<height>100</height>
				<aligny>center</aligny>
				<font>Small</font>
				<textcolor>Dark2</textcolor>
				<label>$INFO[Container(1520).CurrentItem] / $INFO[Container(1520).NumItems]</label>
				<visible>String.IsEmpty(Window.Property(artwork_view))</visible>
			</control>
			<control type="label">
				<left>SidePad</left>
				<bottom>0</bottom>
				<width>300</width>
				<height>100</height>
                <aligny>center</aligny>
    			<font>Small</font>
				<textcolor>Dark2</textcolor>
				<label>$INFO[Container(1520).ListItem.Property(Source)]</label>
				<visible>!String.IsEmpty(Window.Property(artwork_view))</visible>
			</control>
			<!-- Dimensions -->
			<control type="label">
				<right>SidePad</right>
				<bottom>0</bottom>
				<width>400</width>
				<height>100</height>
                <aligny>center</aligny>
				<font>Small</font>
				<textcolor>Dark2</textcolor>
				<align>right</align>
				<label>$INFO[Container(1520).ListItem.Property(Dimensions)]</label>
			</control>
		</control>
	</controls>
</window>
