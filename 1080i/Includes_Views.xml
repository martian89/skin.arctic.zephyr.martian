    <expression name="UsePreviewImageSquare">
        [ !String.Contains(Control.GetLabel(1),(movies)) 
        + !String.Contains(Control.GetLabel(1),(movies-files)) 
        + !String.Contains(Control.GetLabel(1),(movies-sets)) 
        + !String.Contains(Control.GetLabel(1),(sets)) 
        + !String.Contains(Control.GetLabel(1),(tvshows)) 
        + !String.Contains(Control.GetLabel(1),(tvshows-files)) 
        + !String.Contains(Control.GetLabel(1),(episode-groups-tvshows)) 
        + !String.Contains(Control.GetLabel(1),(seasons)) 
        + !String.Contains(Control.GetLabel(1),(episode-groups-seasons)) 
        + !String.Contains(Control.GetLabel(1),(episodes)) 
        + !String.Contains(Control.GetLabel(1),(episodes-files)) 
        + !String.Contains(Control.GetLabel(1),(actors)) 
        + !String.Contains(Control.GetLabel(1),(games)) 
        + !String.Contains(Control.GetLabel(1),(none-games)) 
        + !String.Contains(Control.GetLabel(1),(videoversions)) 
        + !String.Contains(Control.GetLabel(1),(videoextras)) 
        + !String.Contains(Control.GetLabel(1),(videoassets)) ]
