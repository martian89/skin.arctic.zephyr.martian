<?xml version="1.0" encoding="UTF-8"?>
<window>
    <defaultcontrol always="true">3012</defaultcontrol>
    <zorder>10</zorder>
    <controls>
        <control type="label" id="3000">
            <visible>false</visible>
        </control>
        <control type="label" id="3002">
            <visible>false</visible>
        </control>
        <control type="group">
            <include>Animation.FadeIn.Slide</include>
            <include>Animation.FadeOut</include>
            <right>SidePad</right>
            <bottom>SidePad</bottom>
            <width>640</width>
            <height>64</height>
            <control type="image">
                <description>background image</description>
                <top>-8</top>
                <bottom>-8</bottom>
                <left>-8</left>
                <right>-8</right>
                <animation effect="fade" start="100" end="90" condition="true">Conditional</animation>
                <texture border="16" diffuse="diffuse/wall-fanart.png" colordiffuse="$VAR[OSDPanel]">common/rounded-shadow8.png</texture>
            </control>
            <control type="label">
                <visible>Integer.IsGreater(Player.TimeRemaining,59)</visible>
                <left>20</left>
                <right>120</right>
                <height>64</height>
                <bottom>2</bottom>
                <aligny>center</aligny>
                <font>Small</font>
                <label>$ADDON[service.upnext 30049]</label>
                <textcolor>$VAR[OSDPanelWhite100]</textcolor>
            </control>
            <control type="label">
                <visible>!Integer.IsGreater(Player.TimeRemaining,59)</visible>
                <left>20</left>
                <right>120</right>
                <height>64</height>
                <bottom>2</bottom>
                <aligny>center</aligny>
                <font>Small</font>
                <label>$ADDON[service.upnext 30037]</label>
                <textcolor>$VAR[OSDPanelWhite100]</textcolor>
            </control>
            <control type="button" id="3012">
                <description>Play</description>
                <right>64</right>
                <bottom>8</bottom>
                <width>48</width>
                <height>48</height>
                <label/>
                <align>center</align>
                <aligny>center</aligny>
                <textoffsetx>0</textoffsetx>
                <onleft>3013</onleft>
                <onright>3013</onright>
                <font>Null</font>
                <texturefocus colordiffuse="$VAR[ColorHighlight]" border="5">common/box.png</texturefocus>
                <texturenofocus />
            </control>
            <control type="image">
                <description>Play</description>
                <right>72</right>
                <bottom>16</bottom>
                <width>32</width>
                <height>32</height>
                <texture>indicator/playwhite.png</texture>
                <aspectratio>keep</aspectratio>
                <visible>Control.HasFocus(3012)</visible>
            </control>
            <control type="image">
                <description>Play</description>
                <right>72</right>
                <bottom>16</bottom>
                <width>32</width>
                <height>32</height>
                <include content="def_texture" condition="Skin.HasSetting(osd.usetheme)">
                    <param name="texture" value="indicator/playwhite.png" />
                    <param name="colordiffuse" value="Dark1" />
                </include>
                <include content="def_texture" condition="!Skin.HasSetting(osd.usetheme)">
                    <param name="texture" value="indicator/playwhite.png" />
                    <param name="colordiffuse" value="PanelWhite100" />
                </include>
                <aspectratio>keep</aspectratio>
                <visible>!Control.HasFocus(3012)</visible>
            </control>
            <control type="button" id="3013">
                <description>Cancel</description>
                <right>8</right>
                <bottom>8</bottom>
                <width>48</width>
                <height>48</height>
                <label/>
                <align>center</align>
                <aligny>center</aligny>
                <textoffsetx>0</textoffsetx>
                <onleft>3012</onleft>
                <onright>3012</onright>
                <font>Null</font>
                <texturefocus colordiffuse="$VAR[ColorHighlight]" border="5">common/box.png</texturefocus>
                <texturenofocus />
            </control>
            <control type="image">
                <description>Play</description>
                <right>16</right>
                <bottom>16</bottom>
                <width>32</width>
                <height>32</height>
                <texture>buttons/close.png</texture>
                <aspectratio>keep</aspectratio>
                <visible>Control.HasFocus(3013)</visible>
            </control>
            <control type="image">
                <description>Play</description>
                <right>16</right>
                <bottom>16</bottom>
                <width>32</width>
                <height>32</height>
                <include content="def_texture" condition="Skin.HasSetting(osd.usetheme)">
                    <param name="texture" value="buttons/close.png" />
                    <param name="colordiffuse" value="Dark1" />
                </include>
                <include content="def_texture" condition="!Skin.HasSetting(osd.usetheme)">
                    <param name="texture" value="buttons/close.png" />
                    <param name="colordiffuse" value="PanelWhite100" />
                </include>
                <aspectratio>keep</aspectratio>
                <visible>!Control.HasFocus(3013)</visible>
            </control>
            <control type="image">
                <texture colordiffuse="Box2" background="true" border="4" infill="false">common/box21.png</texture>
                <visible>Skin.HasSetting(global.showborders)</visible>
            </control>
            <control type="progress" id="3014">
                <visible>false</visible>
            </control>
        </control>
    </controls>
</window>