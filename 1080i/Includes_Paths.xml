        <value condition="$EXP[ShowTmdbSet] + !String.IsEmpty(Window.Property(videoset))">plugin://plugin.video.themoviedb.helper/?info=collection&amp;tmdb_type=collection&amp;tmdb_id=$INFO[Window(home).Property(TMDbHelper.ListItem.Set.TMDb_ID)]&amp;nextpage=false&amp;cacheonly=true</value>
    </variable>

