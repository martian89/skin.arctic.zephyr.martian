<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog">
	<defaultcontrol always="true">301</defaultcontrol>
	<controls>
        <include content="DefDialog">
            <param name="header_label" value="$INFO[Window.Property(heading)]$INFO[Window.Property(arttype), - [CAPITALIZE],[/CAPITALIZE]]"/>
            <param name="width" value="1853"/>
            <param name="height" value="950"/>

			<control type="group">
				<control type="group">
					<left>35</left>
					<top>115</top>
					<right>374</right>
					<height>750</height>
					<!-- LEFT PANEL - Working Set (30% width) -->
					<control type="group">
						<left>0</left>
						<top>0</top>
						<width>520</width>
						<height>750</height>
						<!-- Panel Label -->
						<control type="label">
						    <left>10</left>
							<width>520</width>
							<height>40</height>
							<font>Button</font>
							<textcolor>Black70</textcolor>
							<align>left</align>
                            <label>$ADDON[script.skin.info.service 32653]</label>
						</control>
						<!-- Current art list - Single column -->
						<control type="panel" id="100">
							<left>0</left>
							<top>40</top>
							<width>520</width>
							<height>711</height>
							<onright>200</onright>
							<onleft>300</onleft>
							<scrolltime>200</scrolltime>
							<itemlayout height="237" width="520">
		                        <control type="group">
		                            <width>300</width>
				                    <control type="group">
				                        <height>178</height>
				                        <control type="image">
				                            <texture border="11" background="true" infill="false">common/$VAR[nofocus-shadow10]</texture>
				                        </control>
				                        <control type="image">
				                            <left>10</left>
				                            <top>10</top>
				                            <right>10</right>
				                            <bottom>10</bottom>
				                            <texture colordiffuse="Black12" border="4" background="true">common/diffuse_box.png</texture>
				                        </control>
				                        <control type="image">
				                            <left>10</left>
				                            <top>10</top>
				                            <right>10</right>
				                            <bottom>10</bottom>
				                            <texture background="true" diffuse="diffuse/widgetfanart_new.png">$INFO[ListItem.Art(thumb)]</texture>
				                            <aspectratio>keep</aspectratio>
				                        </control>
				                        <control type="image">
				                            <left>10</left>
				                            <top>10</top>
				                            <right>10</right>
				                            <bottom>10</bottom>
				                            <texture colordiffuse="BoxWidget" border="4" background="true" infill="false">common/box21.png</texture>
				                            <visible>Skin.HasSetting(global.showborders)</visible>
				                        </control>
				                    </control>
			                        <include content="Def_Artwork_List_Label">
			                            <param name="top" value="178" />
			                        </include>
		                        </control>
								<control type="label">
									<left>305</left>
									<top>10</top>
									<width>210</width>
									<height>30</height>
									<font>Tiny</font>
									<textcolor>Black100</textcolor>
									<label>$INFO[ListItem.Label]</label>
								</control>
							</itemlayout>
							<!-- Focused/Selected for removal layout -->
							<focusedlayout height="237" width="520">
		                        <control type="group">
		                            <width>300</width>
				                    <control type="group">
				                        <height>178</height>
				                        <control type="image">
				                            <texture border="11" background="true" infill="false">common/$VAR[nofocus-shadow10]</texture>
				                        </control>
				                        <control type="image">
				                            <left>10</left>
				                            <top>10</top>
				                            <right>10</right>
				                            <bottom>10</bottom>
				                            <texture colordiffuse="Black12" border="4" background="true">common/diffuse_box.png</texture>
				                        </control>
				                        <control type="image">
				                            <left>10</left>
				                            <top>10</top>
				                            <right>10</right>
				                            <bottom>10</bottom>
				                            <texture background="true" diffuse="diffuse/widgetfanart_new.png">$INFO[ListItem.Art(thumb)]</texture>
				                            <aspectratio>keep</aspectratio>
				                        </control>
				                        <control type="image">
				                            <left>10</left>
				                            <top>10</top>
				                            <right>10</right>
				                            <bottom>10</bottom>
				                            <texture colordiffuse="BoxWidget" border="4" background="true" infill="false">common/box21.png</texture>
				                            <visible>Skin.HasSetting(global.showborders)</visible>
				                        </control>
				                        <include content="def_widgetfocus">
				                            <param name="id" value="100"/>
				                        </include>
				                    </control>
                                    <include content="Def_Artwork_List_Label">
                                        <param name="top" value="178" />
                                    </include>
		                        </control>
								<control type="label">
									<left>305</left>
									<top>10</top>
									<width>210</width>
									<height>30</height>
									<font>Tiny</font>
									<textcolor>Black100</textcolor>
									<label>$INFO[ListItem.Label]</label>
								</control>
								<control type="label">
									<left>305</left>
									<top>40</top>
									<width>210</width>
									<height>30</height>
									<font>Tiny</font>
									<textcolor>Black70</textcolor>
									<label>[B]REMOVE[/B]</label>
									<visible>String.IsEqual(ListItem.Property(selected),true)</visible>
								</control>
							</focusedlayout>
						</control>
					</control>
					<!-- RIGHT PANEL - Available Options (70% width, 3-column grid) -->
					<control type="group">
						<left>520</left>
						<top>0</top>
						<right>0</right>
						<height>750</height>
		
						<!-- Panel Label -->
						<control type="label">
							<left>10</left>
							<top>0</top>
							<width>1120</width>
							<height>40</height>
							<font>Button</font>
							<textcolor>Black70</textcolor>
							<align>left</align>
                            <label>$ADDON[script.skin.info.service 32654]</label>
						</control>

						<!-- Available art grid - 3 columns -->
						<control type="panel" id="200">
							<left>0</left>
							<top>40</top>
							<width>900</width>
							<height>711</height>
							<onleft>100</onleft>
							<onright>64</onright>
		                    <pagecontrol>64</pagecontrol>
							<scrolltime>200</scrolltime>
							<orientation>vertical</orientation>
			                <include content="Def_Artwork_List_Layout">
                                <param name="control_id" value="200" />
			                    <param name="width" value="300" />
			                    <param name="height" value="237" />
			                    <param name="image_height" value="178" />
			                    <param name="aspectratio" value="keep" />
			                </include>
						</control>
						
                        <!-- Busy indicator -->
                        <control type="group">
                            <centerleft>50%</centerleft>
                            <centertop>50%</centertop>
                            <width>400</width>
                            <height>100</height>
                            <visible>Container(200).IsUpdating + Integer.IsEqual(Container(200).NumItems,0)</visible>
                            <include>Animation.DelayFadeIn</include>
                            <include>Animation.FadeOut</include>
                            <include content="BusySpinner">
                                <param name="color" value="Black70" />
                            </include>
                        </control>
					</control>
				</control>
			</control>

            <!-- Lines -->
            <control type="image">
                <top>115</top>
                <right>375</right>
                <height>740</height>
                <width>1</width>
                <texture colordiffuse="Black12">common/white.png</texture>
                <animation effect="fade" start="0" end="100" time="100" condition="!Control.HasFocus(64) + !Container.Scrolling">Conditional</animation>
            </control>

            <!-- Scrollbar -->
            <include content="Furniture_Scrollbar_Dialog">
                <param name="id" value="64"/>
                <param name="height" value="738" />
                <param name="onleft" value="200"/>
                <param name="onright" value="300"/>
            </include>

			<!-- Button Group -->
			<control type="grouplist" id="9000">
	            <top>115</top>              
	            <right>42</right>
	            <width>300</width>
	            <itemgap>DialogButtonsItemgap</itemgap>
	            <orientation>vertical</orientation>
	            <onleft>64</onleft>
	            <onright>100</onright>
	
				<!-- Sort Button -->
				<control type="button" id="303">
	                <include>DefDialogButtons</include>
                    <label>$INFO[Window.Property(sort_label)]</label>
					<visible>String.IsEqual(Window.Property(show_sort_button),true)</visible>
				</control>
	
				<!-- Source Button -->
				<control type="button" id="304">
	                <include>DefDialogButtons</include>
                    <label>$INFO[Window.Property(source_label)]</label>
					<visible>String.IsEqual(Window.Property(show_source_button),true)</visible>
				</control>
	
				<!-- Clear Selection Button -->
				<control type="button" id="302">
	                <include>DefDialogButtons</include>
					<label>$ADDON[script.skin.info.service 32655]</label>
				</control>
	
				<!-- Apply/Confirm Button -->
				<control type="button" id="300">
	                <include>DefDialogButtons</include>
                    <label>$ADDON[script.skin.info.service 32656]</label>
				</control>
	
				<!-- Cancel Button -->
				<control type="button" id="301">
	                <include>DefDialogButtons</include>
                    <label>$LOCALIZE[222]</label>
				</control>
			</control>

            <control type="label">
                <include>Animation.FadeIn</include>
                <include>Animation.FadeOut</include>
                <left>40</left>
                <font>Tiny</font>
                <height>50</height>
                <bottom>30</bottom>
                <align>left</align>
                <textcolor>Black70</textcolor>
                <label>$INFO[Window.Property(count)]</label>
            </control>    
		</include>
	</controls>
</window>
