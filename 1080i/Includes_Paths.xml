<?xml version="1.0" encoding="UTF-8"?>
<includes>

    <variable name="Path_Playlist_Stats">
        <!-- kdk-ignore: xml validation -->    
        <value condition="System.AddonIsEnabled(script.skin.info.service) + String.StartsWith(Container(300).ListItem.Property(action),ActivateWindow) + String.Contains(Container(300).ListItem.Property(action),Videos) + String.StartsWith(Container(300).ListItem.Property(path),special://) + String.EndsWith(Container(300).ListItem.Property(path),.xsp)">plugin://script.skin.info.service/?action=path_stats&amp;path=$INFO[Container(300).ListItem.Property(path)]&amp;reload=$INFO[Window(Home).Property(SkinInfo.Library.Refreshed)]</value>
    </variable>

    <variable name="Path_Playlist_Count">
        <value condition="String.StartsWith(Container(300).ListItem.Property(action),ActivateWindow) + String.Contains(Container(300).ListItem.Property(action),Videos) + String.Contains(Container(300).ListItem.Property(path),playlists) + !String.Contains(Container(300).ListItem.Property(path),.xsp)">special://videoplaylists/</value>
    </variable>

    <variable name="Path_AutoCompletion">
        <!-- kdk-ignore: xml validation -->    
        <value condition="System.AddonIsEnabled(plugin.program.autocompletion)">plugin://plugin.program.autocompletion?info=autocomplete&amp;&amp;id=$INFO[Control.GetLabel(312).index(1)]&amp;&amp;limit=9</value>
    </variable>
    
    <variable name="Path_MovieDB_Movies">
        <value condition="String.IsEqual(Window(1124).Property(content),1)">plugin://plugin.video.themoviedb.helper?info=top_rated&amp;tmdb_type=movie&amp;nextpage=false&amp;cacheonly=true</value>
        <value condition="String.IsEqual(Window(1124).Property(content),2)">plugin://plugin.video.themoviedb.helper?info=popular&amp;tmdb_type=movie&amp;nextpage=false&amp;cacheonly=true</value>
        <value condition="String.IsEqual(Window(1124).Property(content),3)">plugin://plugin.video.themoviedb.helper?info=upcoming&amp;tmdb_type=movie&amp;nextpage=false&amp;cacheonly=true</value>
        <value>plugin://plugin.video.themoviedb.helper?info=now_playing&amp;tmdb_type=movie&amp;nextpage=false&amp;cacheonly=true</value>
    </variable>

    <variable name="Path_MovieDB_Episodes">
        <value condition="String.IsEqual(Window(1125).Property(content),1)">plugin://plugin.video.themoviedb.helper?info=top_rated&amp;tmdb_type=tv&amp;nextpage=false&amp;cacheonly=true</value>
        <value condition="String.IsEqual(Window(1125).Property(content),2)">plugin://plugin.video.themoviedb.helper?info=popular&amp;tmdb_type=tv&amp;nextpage=false&amp;cacheonly=true</value>
        <value condition="String.IsEqual(Window(1125).Property(content),3)">plugin://plugin.video.themoviedb.helper?info=on_the_air&amp;tmdb_type=tv&amp;nextpage=false&amp;cacheonly=true</value>
        <value>plugin://plugin.video.themoviedb.helper?info=airing_today&amp;tmdb_type=tv&amp;nextpage=false&amp;cacheonly=true</value>
    </variable>

    <variable name="Path_ContextParams_TMDbType">
        <value condition="String.IsEqual(ListItem.DBTYPE,movie) | String.IsEqual(ListItem.DBTYPE,set)">movie</value>
        <value condition="String.IsEqual(ListItem.DBTYPE,tvshow) | String.IsEqual(ListItem.DBTYPE,season) | String.IsEqual(ListItem.DBTYPE,episode)">tv</value>
    </variable>

    <variable name="Path_Params_Default">
        <value>&amp;sort_by=premiered&amp;limit=250&amp;nextpage=false&amp;cacheonly=true</value>
    </variable>
    
    <variable name="Path_Param_Query">
        <value condition="String.IsEqual(ListItem.DBType,movie) + !String.isEmpty(ListItem.UniqueId(tmdb))">$INFO[ListItem.UniqueId(tmdb),&amp;tmdb_id=,]</value>
        <value condition="String.IsEqual(ListItem.DBType,movie) + !String.IsEmpty(ListItem.Property(imdb_id))">$INFO[ListItem.Property(imdb_id),&amp;imdb_id=,]</value>
        <value condition="String.IsEqual(ListItem.DBType,movie) | String.IsEqual(ListItem.DBType,tvshow)">$INFO[Window(home).Property(TMDbHelper.ListItem.tmdb_id),&amp;tmdb_id=,]$VAR[Path_Encoded_Title,&amp;query=,]$INFO[ListItem.Year,&amp;year=,]</value>        
        <value condition="String.IsEqual(ListItem.DBType,episode)">$INFO[Window(home).Property(TMDbHelper.ListItem.tvshow.tmdb_id),&amp;tmdb_id=,]$VAR[Path_Encoded_TvShowTitle,&amp;query=,]$INFO[ListItem.Season,&amp;season=,]$INFO[ListItem.Episode,&amp;episode=,]$INFO[ListItem.Year,&amp;episode_year=,]</value>
        <value condition="String.IsEqual(ListItem.DBType,season) | String.StartsWith(ListItem.Label,Season)">$INFO[Window(home).Property(TMDbHelper.ListItem.tvshow.tmdb_id),&amp;tmdb_id=,]$VAR[Path_Encoded_TvShowTitle,&amp;query=,]$INFO[ListItem.Season,&amp;season=,]</value>
        <value condition="!String.IsEmpty(ListItem.Title)">$VAR[Path_Encoded_Title,&amp;query=,]$INFO[ListItem.Year,&amp;year=,]</value>
        <value>$VAR[Path_Encoded_Label,&amp;query=,]</value>
    </variable>

