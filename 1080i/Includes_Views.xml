		<value condition="Container.Content(seasons) + String.IsEqual(Container.Property(param.info),episode_group_seasons)">episode-groups-seasons</value>
        <value condition="Container.Content(videoversions) + String.IsEqual(Container.FolderPath,videodb://movies/videoversions/)">videoversions-versions</value>
		<value condition="Container.Content() + String.IsEqual(Container.Property(param.info),watch_providers)">none-providers</value>
		<value condition="Container.Content() + String.IsEqual(Container.Property(param.info),dir_calendar_library)">none-calendar</value>
		<value condition="Container.Content() + String.IsEqual(Container.Property(param.info),dir_calendar_trakt)">none-calendar</value>
		<value condition="!Container.Content() + !Container.Content(images) + !Container.Content(videos) + !Container.Content(movies) + !Container.Content(sets) + !Container.Content(tvshows) + !Container.Content(seasons) + !Container.Content(episodes) + !Container.Content(videoextras) + !Container.Content(videoversions) + !Container.Content(genres) + !Container.Content(years) + !Container.Content(studios) + !Container.Content(directors) + !Container.Content(countries) + !Container.Content(tags) + !Container.Content(roles) + !Container.Content(actors) + !Container.Content(playlists) + !Container.Content(musicvideos) + !Container.Content(artists) + !Container.Content(albums) + !Container.Content(songs) + !Container.Content(files) + !Container.Content(sources) + !Container.Content(addons) + !Container.Content(recordings) + !Container.Content(favourites) + !Container.Content(games)">other</value>
