    <variable name="Path_InfoParams_TMDb_Type">
        <value condition="ListItem.IsCollection | String.IsEqual(ListItem.DBType,set)">collection</value>    
        <value condition="String.IsEqual(ListItem.DBType,tvshow)">tv</value>    
        <value condition="String.IsEqual(ListItem.DBType,movie)">movie</value>    
        <value condition="String.IsEqual(ListItem.DBType,season)">season</value>
        <value condition="String.IsEqual(ListItem.DBType,episode)">episode</value>
    </variable>

    <variable name="Path_InfoParams_TMDb_ID">
        <value condition="String.IsEqual(ListItem.DBType,season) | String.IsEqual(ListItem.DBType,episode)">$INFO[ListItem.Property(tvshow.tmdb_id)]</value>    
        <value>$INFO[ListItem.Property(tmdb_id)]</value>
    </variable>

    <variable name="Path_InfoParams_Season">
        <value condition="String.IsEqual(ListItem.DBType,season) | String.IsEqual(ListItem.DBType,episode)">$INFO[ListItem.Season]</value>    
    </variable>

    <variable name="Path_InfoParams_Episode">
        <value condition="String.IsEqual(ListItem.DBType,episode)">$INFO[ListItem.Episode]</value>    
    </variable>
        
    <variable name="Path_InfoParams_DBID">
        <value>$INFO[ListItem.DBID]</value>
    </variable>

    <variable name="Path_VideoInfo_OnClickAction">
        <value>RunScript(script.skinvariables,run_executebuiltin=special://skin/shortcuts/builtins/skinvariables-openinfo.json,use_rules=True)</value>
    </variable>

    <variable name="Path_VideoInfo_IMDbTrailer">
        <value condition="!String.IsEmpty(ListItem.UniqueId(imdb))">plugin://plugin.video.imdb.trailers/?action=play_id&amp;imdb=$INFO[ListItem.UniqueId(imdb)]</value>
        <value condition="!String.IsEmpty(Window(home).Property(TMDbHelper.ListItem.imdb_id))">plugin://plugin.video.imdb.trailers/?action=play_id&amp;imdb=$INFO[Window(home).Property(TMDbHelper.ListItem.imdb_id)]</value>
    </variable>

    <variable name="Path_VideoInfo_Youtube">
        <value condition="String.IsEmpty(Window(Home).Property(TMDbHelper.ListItem.DBType))">special://skin/extras/Null.xsp</value>
        <value condition="!String.IsEmpty(Window.Property(videoyoutube))">plugin://plugin.video.youtube/search/?q=$VAR[Path_Youtube_Query]</value>
    </variable>

    <variable name="Path_VideoInfo_OnlineFanart">
        <value condition="String.IsEmpty(Window(Home).Property(TMDbHelper.ListItem.DBType))">special://skin/extras/Null.xsp</value>
        <value condition="$EXP[ShowTmdbArtwork]">plugin://plugin.video.themoviedb.helper/?info=fanart&amp;tmdb_type=$VAR[Path_ContextParams_TMDbType]$VAR[Path_Param_Query]&amp;nextpage=false</value>
    </variable>

    <variable name="Path_VideoInfo_OnlineCollection">
