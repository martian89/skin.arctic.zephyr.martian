<?xml version="1.0" encoding="UTF-8"?>
<!-- Foundation -->
<window>
    <defaultcontrol always="true">101</defaultcontrol>
    <controls>
        <control type="group">
            <include>Animation.FadeIn</include>
            <include>Animation.FadeOut</include>
            <visible>!Window.IsActive(GameVideoFilter) + !Window.IsActive(GameStretchMode) + !Window.IsActive(GameVideoRotation) + !Window.IsActive(InGameSaves) + !Window.IsActive(DialogSlider.xml)</visible>
            <include>GlobalOverlay</include>
        </control>
		<control type="group">
			<visible>System.GetBool(gamesgeneral.showosdhelp)</visible>
			<include content="DefDialogBackground">
			    <param name="width" value="860"/>
			    <param name="height" value="940"/>
			</include>			
			<control type="label">
			    <include>DefDialogHeader</include>
			    <label>10043</label>
			</control>			
			<include content="Kodi_Logo">
			    <param name="dimensions" value="40"/>
			    <param name="top" value="40"/>
			    <param name="left" value="40"/>
			</include>			
			<!-- Lines -->
			<control type="image">
			    <top>95</top>
			    <left>40</left>
			    <right>40</right>
			    <height>1</height>
			    <bottom>10</bottom>
			    <colordiffuse>Black12</colordiffuse>
			    <texture>common/white.png</texture>
			</control>  
			<control type="textbox" id="1101">
				<description>Help text</description>
				<top>115</top>
				<left>40</left>
				<right>40</right>
				<height>100</height>
				<font>Small</font>
			</control>
			<control type="gamecontroller">
				<top>230</top>
				<centerleft>50%</centerleft>
				<width>500</width>
				<height>500</height>
				<controllerid>game.controller.snes</controllerid>
			</control>
			<control type="textbox">
				<description>Additional help text. This will be removed in future versions.</description>
				<bottom>130</bottom>
				<left>40</left>
				<right>40</right>
				<height>80</height>
				<font>Small</font>
				<label>$LOCALIZE[35236]</label>
			</control>
	        <control type="button" id="101">
				<description>Button to close the dialog</description>
				<bottom>30</bottom>
				<centerleft>50%</centerleft>
	            <width>270</width>
				<label>15067</label>
	            <font>Button</font>
	            <texturefocus colordiffuse="$VAR[ColorHighlight]" border="5">common/box.png</texturefocus>
	            <texturenofocus colordiffuse="Black12" border="5">common/box.png</texturenofocus>
				<onclick>Action(close)</onclick>
	        </control>
		</control>
        <control type="group">
			<visible>!System.GetBool(gamesgeneral.showosdhelp)</visible>
            <visible>!Window.IsActive(1131) + !Window.IsActive(InGameSaves) + !Window.IsActive(GameDiscManager) + !Window.IsActive(GameAchievements) + !Window.IsActive(GameCheats)</visible>
            <visible allowhiddenfocus="true">ControlGroup(9000).HasFocus()</visible>
            <top>184</top>
            <centerleft>50%</centerleft>
            <height>690</height>
            <width>566</width>
            <include>Animation.ZoomIn</include>
            <include>Animation.FadeOut</include>
            <control type="image">
                <description>background image</description>
                <top>0</top>
                <left>0</left>
                <right>0</right>
                <bottom>140</bottom>
                <texture border="16" colordiffuse="White100">common/rounded-shadow8.png</texture>
                <visible>Integer.IsEqual(Container(9000).NumItems,6)</visible>
            </control>
            <control type="image">
                <description>background image</description>
                <top>0</top>
                <left>0</left>
                <right>0</right>
                <bottom>70</bottom>
                <texture border="16" colordiffuse="White100">common/rounded-shadow8.png</texture>
                <visible>Integer.IsEqual(Container(9000).NumItems,7)</visible>
            </control>
            <control type="image">
                <description>background image</description>
                <top>0</top>
                <left>0</left>
                <right>0</right>
                <bottom>0</bottom>
                <texture border="16" colordiffuse="White100">common/rounded-shadow8.png</texture>
                <visible>Integer.IsGreater(Container(9000).NumItems,7)</visible>
            </control>
			<include>Def9000Arrows</include>
			<include content="Def9000Header">
				<param name="header_label" value="35221" />
			</include>
            <include content="Def_Gradient_Settings_Image">
                <param name="controlid" value="9000"/>
                <param name="top" value="115"/>
                <param name="left" value="8"/>
                <param name="right" value="8"/>
                <param name="align_right" value="true"/>
                <param name="overlayfix" value="true"/>
                <param name="delay" value="20"/>
            </include>
            <control type="grouplist" id="9000">
                <include>Def9000GroupList</include>
                <control type="button" id="101">
                    <description>Pause / Resume button</description>
                    <align>left</align>
					<width>100%</width>
                    <label>$LOCALIZE[35224]</label>
					<label2>[COLOR Black30]$FEATURE[select,game.controller.snes] + $FEATURE[x,game.controller.default][/COLOR]</label2>
                    <include>DefContextButtonGradient</include>
                    <onclick>Play</onclick>
                </control>
                <control type="button" id="102">
                    <description>Save / Load button</description>
                    <align>left</align>
					<width>100%</width>
                    <label>$LOCALIZE[35249]</label>
                    <include>DefContextButtonGradient</include>
                    <onclick>ActivateWindow(InGameSaves)</onclick>
                </control>
                <control type="button" id="103">
					<description>Disc Manager button</description>
					<align>left</align>
					<width>100%</width>
					<label>$LOCALIZE[35272]</label>
                    <include>DefContextButtonGradient</include>
					<onclick>ActivateWindow(GameDiscManager)</onclick>
					<visible>RetroPlayer.SupportsEject</visible>
                </control>
                <control type="button" id="104">
                    <description>Players button</description>
                    <align>left</align>
					<width>100%</width>
                    <label>$LOCALIZE[35172]</label>
                    <include>DefContextButtonGradient</include>
                    <onclick>ActivateWindow(GameAgents)</onclick>
                </control>
                <!-- 
                <control type="button" id="105">
                    <description>Always show Achievements; its dialog explains sign-in requirements and missing achievement sets.</description>
                    <align>left</align>
					<width>100%</width>
                    <label>$LOCALIZE[35287]</label>
                    <label2>$INFO[RetroPlayer.AchievementsProgress]</label2>
                    <include>DefContextButtonGradient</include>
                    <onclick>ActivateWindow(GameAchievements)</onclick>
                </control>
                <control type="button" id="106">
                    <align>left</align>
					<width>100%</width>
                    <label>$LOCALIZE[35320]</label>
                    <include>DefContextButtonGradient</include>
                    <visible>RetroPlayer.HasCheats</visible>
                    <onclick>ActivateWindow(GameCheats)</onclick>
                </control>
                -->
                <control type="button" id="107">
                    <description>Reset button</description>
                    <align>left</align>
					<width>100%</width>
                    <label>$LOCALIZE[13007]</label>
                    <include>DefContextButtonGradient</include>
                    <onclick>PlayerControl(Reset)</onclick>
                </control>
                <control type="button" id="108">
                    <description>Stop button</description>
                    <align>left</align>
					<width>100%</width>
                    <label>$LOCALIZE[35222]</label>
					<label2>[COLOR Black30]$FEATURE[select,game.controller.snes] + $FEATURE[start,game.controller.default][/COLOR]</label2>
                    <include>DefContextButtonGradient</include>
                    <onclick>Stop</onclick>
                </control>
                <control type="button" id="109">
                    <description>Settings</description>
                    <align>left</align>
					<width>100%</width>
                    <label>$LOCALIZE[5]</label>
                    <include>DefContextButtonGradient</include>
		            <onclick>SetProperty(CustomDialogSettingsContent,gamesettings,home)</onclick>
                    <onclick>ActivateWindow(1131)</onclick>
                </control>
            </control>
        </control>
    </controls>
</window>