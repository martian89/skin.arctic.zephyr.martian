            <visible>![Window.IsVisible(Home.xml) + Skin.HasSetting(homemenu.netflix) + !Skin.HasSetting(hide.homemenu.netflix.preview) | [Control.IsVisible(521) | Control.IsVisible(522) | Control.IsVisible(523) | Control.IsVisible(524)] + !Skin.HasSetting(hide.views.netflix.preview) + !$EXP[TMDbHelperBlurEnabled] + !Skin.HasSetting(global.hidefanart)] | $EXP[InfoDialogsActive] + [!Window.IsVisible(home) | !$EXP[InfoDialogsExtendedBackground]]</visible>
            <include>Animation.BackgroundHideView</include>
            <control type="multiimage" description="Fanart">
                <visible>!$EXP[TMDbHelperBlurEnabled] | [Window.IsVisible(home) + !$EXP[InfoDialogsActive]]</visible>
                <visible>!Skin.HasSetting(global.hidefanart) | Window.IsVisible(home)</visible>
                <visible>!Player.HasMedia | [!Skin.HasSetting(global.showvideo) + Player.HasVideo] | [!Skin.HasSetting(global.showvisualisation) + Player.HasAudio] | [Skin.HasSetting(global.showvisualisation) + String.IsEmpty(Visualisation.Name) + Player.HasAudio]</visible>
                <include condition="![Window.IsVisible(home) + [$EXP[HomeIsSpotlight] | $EXP[HomeIsClassic]]]">GlobalBackgroundFade</include>
                <include>Dimensions_Fullscreen</include>
                <include>Animation.Background.OpenClose</include>
                <include>BackgroundFanartFadetime</include>
                <timeperimage>HomeTimePerImage</timeperimage>
                <randomize>true</randomize>
                <aspectratio>scale</aspectratio>
                <imagepath background="true">$VAR[GlobalFanart]</imagepath>
                <include>Animation.Animate.Fanart</include>
                <include>Animation.AutoTrailer.FadeOut.Background</include>
            </control>

            <control type="multiimage" description="Fanart">
                <visible>$EXP[TMDbHelperBlurEnabled] + [!Window.IsVisible(home) | $EXP[InfoDialogsActive]]</visible>
                <visible>!Skin.HasSetting(global.hidefanart) | Window.IsVisible(home)</visible>
                <visible>!Player.HasMedia | [!Skin.HasSetting(global.showvideo) + Player.HasVideo] | [!Skin.HasSetting(global.showvisualisation) + Player.HasAudio] | [Skin.HasSetting(global.showvisualisation) + String.IsEmpty(Visualisation.Name) + Player.HasAudio]</visible>
