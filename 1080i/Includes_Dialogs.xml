    <include name="Dialog_ManageArtworkList_Layout">
        <param name="control_id" default="100" />
        <param name="itemlayout_w" default="355" />
        <param name="itemlayout_h" default="345" />
        <param name="condition" default="true" />
        <param name="title_overlay" default="false" />
        <param name="bordersize" default="0" />
        <param name="aspectratio" default="scale" />
        <param name="diffuse" default="diffuse/widgetfanart_new.png" />
        <param name="image_offset_x" default="0" />
        <param name="image_w" default="100%"/>
        <param name="image_h" />
        <definition>
            <itemlayout height="$PARAM[itemlayout_h]" width="$PARAM[itemlayout_w]" condition="$PARAM[condition]">
                <control type="group">
                    <width>$PARAM[image_w]</width>
                    <left>$PARAM[image_offset_x]</left>
                    <control type="group">
                        <height>$PARAM[image_h]</height>
                        <control type="image">
                            <texture border="11" background="true" infill="false">common/$VAR[nofocus-shadow10]</texture>
                        </control>
                        <control type="image">
                            <left>10</left>
                            <top>10</top>
                            <right>10</right>
                            <bottom>10</bottom>
                            <texture colordiffuse="Black12" border="4" background="true">common/diffuse_box.png</texture>
                        </control>
                        <control type="image">
                            <left>10</left>
                            <top>10</top>
                            <right>10</right>
                            <bottom>10</bottom>
                            <bordersize>$PARAM[bordersize]</bordersize>
                            <texture background="true" diffuse="$PARAM[diffuse]">$INFO[ListItem.Art(thumb)]</texture>
                            <aspectratio>$PARAM[aspectratio]</aspectratio>
                        </control>
                        <control type="image">
                            <bottom>10</bottom>
                            <right>10</right>
                            <height>75</height>
                            <left>10</left>
                            <texture colordiffuse="D9333333">common/black-back.png</texture>
                            <visible>$PARAM[title_overlay]</visible>
                        </control>
                        <control type="image">
                            <left>10</left>
                            <top>10</top>
                            <right>10</right>
                            <bottom>10</bottom>
                            <texture colordiffuse="BoxWidget" border="4" background="true" infill="false">common/box21.png</texture>
                            <visible>Skin.HasSetting(global.showborders)</visible>
                        </control>
                    </control>
                    <control type="group">
                        <include content="def_top" condition="$PARAM[title_overlay]">
                            <param name="top" value="-76" />
                        </include>                   
                        <include content="Dialog_ManageArtworkList_Label" condition="$PARAM[title_overlay]">
                            <param name="top" value="$PARAM[image_h]" />
                            <param name="color1" value="PanelWhite100" />  
                            <param name="color2" value="PanelWhite70" />  
                        </include>
                        <include content="Dialog_ManageArtworkList_Label" condition="!$PARAM[title_overlay]">
                            <param name="top" value="$PARAM[image_h]" />
                        </include>
                    </control>
                </control>
                <include>Dialog_ManageArtworkList_InheritedIndicator</include>
            </itemlayout>
            <focusedlayout height="$PARAM[itemlayout_h]" width="$PARAM[itemlayout_w]" condition="$PARAM[condition]">
                <control type="group">
                    <width>$PARAM[image_w]</width>
                    <left>$PARAM[image_offset_x]</left>
                    <control type="group">
                        <height>$PARAM[image_h]</height>
                        <control type="image">
                            <texture border="11" background="true" infill="false">common/$VAR[nofocus-shadow10]</texture>
                        </control>
                        <control type="image">
                            <left>10</left>
                            <top>10</top>
                            <right>10</right>
                            <bottom>10</bottom>
                            <texture colordiffuse="Black12" border="4" background="true">common/diffuse_box.png</texture>
                        </control>
                        <control type="image">
                            <left>10</left>
                            <top>10</top>
                            <right>10</right>
                            <bottom>10</bottom>
                            <bordersize>$PARAM[bordersize]</bordersize>
                            <texture background="true" diffuse="$PARAM[diffuse]">$INFO[ListItem.Art(thumb)]</texture>
                            <aspectratio>$PARAM[aspectratio]</aspectratio>
                        </control>
                        <control type="image">
                            <bottom>10</bottom>
                            <right>10</right>
                            <height>75</height>
                            <left>10</left>
                            <texture colordiffuse="D9333333">common/black-back.png</texture>
                            <visible>$PARAM[title_overlay]</visible>
                        </control>
                        <control type="image">
                            <left>10</left>
                            <top>10</top>
                            <right>10</right>
                            <bottom>10</bottom>
                            <texture colordiffuse="BoxWidget" border="4" background="true" infill="false">common/box21.png</texture>
                            <visible>Skin.HasSetting(global.showborders)</visible>
                        </control>
                        <include content="def_widgetfocus">
                            <param name="id" value="$PARAM[control_id]"/>
                        </include>
                    </control>
                    <control type="group">
                        <include content="def_top" condition="$PARAM[title_overlay]">
                            <param name="top" value="-76" />
                        </include>                   
                        <include content="Dialog_ManageArtworkList_Label" condition="$PARAM[title_overlay]">
                            <param name="top" value="$PARAM[image_h]" />
                            <param name="color1" value="PanelWhite100" />  
                            <param name="color2" value="PanelWhite70" />  
                        </include>
                        <include content="Dialog_ManageArtworkList_Label" condition="!$PARAM[title_overlay]">
                            <param name="top" value="$PARAM[image_h]" />
                        </include>
                    </control>
                </control>
                <include>Dialog_ManageArtworkList_InheritedIndicator</include>
            </focusedlayout>
        </definition>
    </include>

