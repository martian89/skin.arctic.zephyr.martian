<?xml version="1.0" encoding="UTF-8"?>
<window>
	<defaultcontrol always="true">50</defaultcontrol>
    <backgroundcolor>0</backgroundcolor>
    <menucontrol>9000</menucontrol>
    <include>View_IDs</include>
    <include>Blur_OnLoad_Action</include>
    <include>Generator_BuildViewTypes_Onload</include>
    <onunload condition="Skin.HasSetting(home.netflix.autoplay.trailer) + $EXP[TrailerIsPlaying] + !Skin.HasSetting(trailer.dont.stop.on.unfocus) + !Window.Next(FullScreenVideo)">ClearProperty(TrailerPath,home)</onunload>
    <onunload condition="Skin.HasSetting(home.netflix.autoplay.trailer) + $EXP[TrailerIsPlaying] + !Skin.HasSetting(trailer.dont.stop.on.unfocus) + !Window.Next(FullScreenVideo)">Stop</onunload>
    <onunload condition="Skin.HasSetting(home.netflix.autoplay.trailer)">ClearProperty(listitem.trailer,home)</onunload>
    <controls>
        <include>GlobalBackground</include>
        <include>View_Includes</include>
        <include>Furniture_Jumpbar</include>
        <include>Furniture_Header</include>
        <include>Furniture_NowPlaying</include>
        <include>Furniture_Clock</include>
        <include>Furniture_Weather</include>
        <include content="View_SideBlade">
            <param name="hidden_items_1" value="[[!Player.HasMedia + !Player.Playing] + [Control.IsVisible(500) | Control.IsVisible(550) | Control.IsVisible(555)]]" />
            <control type="grouplist" id="9000">
                <include>Def9000GroupList</include>
                <include>View_Options</include>
                <!-- Other Options -->
                <control type="button" id="55553">
                    <include>DefContextMenuLabel</include>
                    <label>587</label>
                </control>
                <control type="edit" id="19">
                    <label>587</label>
                    <description>Filter (hidden)</description>
                    <align>left</align>
                    <include>DefContextButtonGradient</include>
                    <visible>!Container.CanFilterAdvanced</visible>
                </control>
                <control type="radiobutton" id="98">
                    <visible>Container.CanFilterAdvanced</visible>
                    <description>Filter</description>
                    <include>DefContextButtonGradient</include>
                    <label>587</label>
                    <align>left</align>
                    <onclick>SetFocus(50)</onclick>
                    <onclick>Filter</onclick>
                    <selected>Container.Filtered</selected>
                </control>
                <control type="button" id="55554">
                    <include>DefContextMenuLabel</include>
                    <label>31077</label>
                </control>
                <control type="button" id="9091">
                    <description>Global Search</description>
                    <include>DefContextButtonGradient</include>
                    <align>left</align>
                    <label>137</label>
                    <onclick>SetFocus(50)</onclick>
                    <include content="Def_GlobalSearch_Actions">
                    </include>
                </control>
                <include>View_SideBlade_NowPlaying</include>
            </control>
        </include>
    </controls>
</window>
